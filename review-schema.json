{
  "type": "object",
  "properties": {
    "conclusion": { "type": "string", "enum": ["success", "failure", "neutral"] },
    "summary": { "type": "string", "description": "Use judgment to share useful insights, even when they do not change the verdict. Empty when there is nothing useful beyond routine checks, approval or what you already said in discussion to add, so approval has no body. After a substantive reply, include only additional useful insight; no second recap or generic sign-off such as LGTM. For failure, name the blocking behavior and consequence. Keep it concise; no verdict restatement, change inventory or routine CI recap." },
    "reactions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "enum": ["+1", "-1", "laugh", "hooray", "confused", "heart", "rocket"] }
    },
    "commits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "sha": { "type": "string" },
          "conclusion": { "type": "string", "enum": ["success", "failure"] }
        },
        "required": ["sha", "conclusion"],
        "additionalProperties": false
      }
    },
    "merge": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "method": { "type": "string", "enum": ["squash", "merge", "rebase"] },
            "subject": { "type": "string" },
            "body": { "type": "string" }
          },
          "required": ["method", "subject", "body"],
          "additionalProperties": false
        }
      ]
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "line": { "type": "integer" },
          "level": { "type": "string", "enum": ["notice", "warning", "failure"] },
          "message": { "type": "string" }
        },
        "required": ["path", "line", "level", "message"],
        "additionalProperties": false
      }
    }
  },
  "required": ["conclusion", "summary", "reactions", "commits", "merge", "annotations"],
  "additionalProperties": false
}
