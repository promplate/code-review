{
  "type": "object",
  "properties": {
    "conclusion": { "type": "string", "enum": ["success", "failure", "neutral"] },
    "summary": { "type": "string", "description": "For a clean approval, an empty string or a brief LGTM if ready to merge. Otherwise only the decisive reason or material uncertainty in one or two short sentences; for failure, name the blocking behavior and consequence. No verdict restatement, change inventory or routine CI recap." },
    "reactions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "enum": ["+1", "-1", "laugh", "hooray", "confused", "heart", "rocket"] }
    },
    "commits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "sha": { "type": "string" },
          "conclusion": { "type": "string", "enum": ["success", "failure"] }
        },
        "required": ["sha", "conclusion"],
        "additionalProperties": false
      }
    },
    "merge": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "method": { "type": "string", "enum": ["squash", "merge", "rebase"] },
            "subject": { "type": "string" },
            "body": { "type": "string" }
          },
          "required": ["method", "subject", "body"],
          "additionalProperties": false
        }
      ]
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "line": { "type": "integer" },
          "level": { "type": "string", "enum": ["notice", "warning", "failure"] },
          "message": { "type": "string" }
        },
        "required": ["path", "line", "level", "message"],
        "additionalProperties": false
      }
    }
  },
  "required": ["conclusion", "summary", "reactions", "commits", "merge", "annotations"],
  "additionalProperties": false
}
